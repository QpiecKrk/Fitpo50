{
  "name": "fitpo50",
  "version": "1.0.0",
  "description": "FitPo50 website",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "article:new": "node scripts/create-article-from-template.js",
    "article:validate": "node scripts/validate-article-standard.js",
    "article:guard": "node scripts/article-publish-guard.js",
    "article:guard:diff": "node scripts/run-article-guard-diff.js",
    "reading-room:verify": "node scripts/reading-room-link-verifier.js --diff",
    "schema:validate": "node scripts/schema-validator.js --diff",
    "adsense:readiness": "node scripts/adsense-readiness-check.js",
    "faq:refresh:report": "node scripts/faq-refresh-report.js",
    "content:freshness:report": "node scripts/content-freshness-bot.js",
    "gsc:weekly:api": "node scripts/gsc-weekly-api-report.js",
    "gsc:weekly:report": "node scripts/gsc-weekly-csv-report.js",
    "live:postpush:check": "bash scripts/live-postpush-check.sh https://fitpo50.pl",
    "article:pdf:sync": "python3 scripts/sync_article_pdfs_and_buttons.py",
    "predeploy:check": "node scripts/predeploy-gate.js && node scripts/seo-aeo-guard.js",
    "seo:aeo:guard": "node scripts/seo-aeo-guard.js",
    "news:integrity": "node scripts/news-integrity-check.js",
    "assets:mirror:sync": "node scripts/sync-site-assets-mirror.js",
    "assets:mirror:check": "node scripts/sync-site-assets-mirror.js --check",
    "json:gate:diff": "node scripts/json-fitpo50-gate-diff.js",
    "json:gate:file": "node scripts/json-fitpo50-gate-diff.js --file \"$npm_config_file\"",
    "json:fix": "node scripts/fix-fitpo50-json.js",
    "article:preflight": "node scripts/article-preflight.js",
    "article:assets:prepare": "node scripts/prepare-article-assets.js",
    "article:lint:placeholders": "node scripts/lint-editorial-placeholders.js",
    "article:pipeline": "node scripts/article-pipeline.js",
    "article:publish": "npm run article:pipeline -- --file \"$npm_config_file\"",
    "article:import:safe": "node scripts/fix-fitpo50-json.js --file \"$npm_config_file\" --write true && node scripts/import-article.js --file \"$npm_config_file\" --publish true --run-internal-links false --validate true",
    "prepush:diff-guard": "node scripts/prepush-diff-guard.js",
    "smoke:static": "node scripts/static-smoke-check.js /tmp/fitpo50-export-check",
    "broken-links:crawl": "node scripts/broken-links-crawler.js /tmp/fitpo50-export-check",
    "hostinger:clean-repo": "bash scripts/hostinger-clean-repo.sh",
    "workflow:maintenance": "node scripts/workflow-maintenance-check.js",
    "check:build-export": "npm run build && SKIP_TS_BUILD=1 ./scripts/export_site.sh /tmp/fitpo50-export-check && npm run smoke:static && npm run broken-links:crawl",
    "prepush:local": "npm run prepush:diff-guard && npm run assets:mirror:check && npm run predeploy:check && npm run news:integrity && npm run article:guard:diff && npm run reading-room:verify && npm run schema:validate && npm run adsense:readiness && npm run json:gate:diff && npm run check:build-export",
    "hooks:install": "bash scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "terser": "^5.46.1",
    "typescript": "^5.5.0",
    "undici-types": "^8.1.0"
  }
}
