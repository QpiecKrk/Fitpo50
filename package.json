{
  "name": "fitpo50",
  "version": "1.0.0",
  "description": "FitPo50 website",
  "main": "dist/app.js",
  "scripts": {
    "build": "npm run build:esbuild",
    "build:esbuild": "esbuild src/app.ts src/cmp.ts src/footer.ts src/search.ts src/protein-calculator.ts src/phenoage-calculator.ts --outdir=dist --target=es2018 --format=iife --log-level=error",
    "session:start": "node scripts/agent-context.js && node scripts/fitpo50-doctor.js",
    "fitpo50:doctor": "node scripts/fitpo50-doctor.js",
    "agent:context": "node scripts/agent-context.js",
    "admin:doctor": "node scripts/admin-doctor.js",
    "reports:prune:dry": "node scripts/reports-prune.js --dry-run",
    "reports:prune": "node scripts/reports-prune.js",
    "postinstall": "bash scripts/install-git-hooks.sh || true",
    "typecheck": "tsc --noEmit --pretty false",
    "build:strict": "npm run typecheck && npm run build:esbuild",
    "article:new": "node scripts/create-article-from-template.js",
    "article:manager": "node scripts/article-manager.js",
    "article:validate": "node scripts/validate-article-standard.js",
    "article:validate:center": "node scripts/validate-article.js",
    "article:guard": "node scripts/article-publish-guard.js",
    "article:guard:diff": "node scripts/run-article-guard-diff.js",
    "article:contract": "node scripts/article-contract-check.js",
    "article:contract:diff": "node scripts/run-article-contract-diff.js",
    "article:meta:set": "node scripts/article-meta-set.js",
    "article:meta:sync": "node scripts/sync-article-metadata.js",
    "article:head:sync": "node scripts/sync-article-head-descriptions.js",
    "reading-room:verify": "node scripts/reading-room-link-verifier.js --diff",
    "schema:validate": "node scripts/schema-validator.js --diff",
    "adsense:readiness": "node scripts/adsense-readiness-check.js",
    "faq:refresh:report": "node scripts/faq-refresh-report.js",
    "content:freshness:report": "node scripts/content-freshness-bot.js",
    "gsc:weekly:api": "node scripts/gsc-weekly-api-report.js",
    "gsc:weekly:api:local": "bash scripts/with-local-env.sh node scripts/gsc-weekly-api-report.js",
    "gsc:weekly:report": "node scripts/gsc-weekly-csv-report.js",
    "gsc:priority-map": "node scripts/gsc-priority-map.js",
    "gsc:auto": "node scripts/gsc-auto-report.js",
    "gsc:tool": "node scripts/gsc-tool.js",
    "seo:aio:machine": "node scripts/seo-aio-command-center.js",
    "seo:aio:apply-wave": "node scripts/seo-aio-wave-autopilot.js",
    "gsc:indexing:watchdog": "node scripts/gsc-indexing-watchdog.js",
    "growth": "node scripts/growth-tool.js",
    "growth:report": "node scripts/growth-tool.js report",
    "growth:audit-ai": "node scripts/growth-tool.js audit-ai",
    "growth:ai-visibility-test": "node scripts/growth-tool.js ai-visibility-test",
    "growth:entities": "node scripts/growth-tool.js entities",
    "growth:structured-score": "node scripts/growth-tool.js structured-score",
    "growth:quick-answer-score": "node scripts/growth-tool.js quick-answer-score",
    "growth:gsc-generative-ai": "node scripts/growth-tool.js gsc-generative-ai",
    "growth:post-deploy-kpi": "node scripts/growth-tool.js post-deploy-kpi",
    "growth:originality-score": "node scripts/growth-tool.js originality-score",
    "growth:topical-map": "node scripts/growth-tool.js topical-map",
    "growth:llms-check": "node scripts/growth-tool.js llms-check",
    "growth:full-audit": "node scripts/growth-tool.js full-audit",
    "aio:full-audit": "node scripts/growth-tool.js full-audit",
    "growth:perplexity-monitor": "node scripts/growth-tool.js perplexity-monitor",
    "growth:gsc-refresh": "node scripts/growth-tool.js gsc-refresh",
    "growth:evidence-plan": "node scripts/growth-tool.js evidence-plan",
    "growth:hubs": "node scripts/growth-tool.js hubs",
    "preview:hubs": "node scripts/build-preview-hubs.js",
    "growth:link-assets": "node scripts/growth-tool.js link-assets",
    "growth:autopilot": "node scripts/growth-tool.js autopilot",
    "popraw-seo": "node scripts/growth-tool.js popraw-seo",
    "popraw-seo:gsc-local": "bash scripts/with-local-env.sh node scripts/gsc-weekly-api-report.js && npm run gsc:priority-map -- --input-dir data/gsc --output-dir data/reports && npm run seo:aio:machine -- --input-dir data/reports --output-dir data/reports && npm run popraw-seo",
    "growth:apply:dry": "node scripts/growth-tool.js apply",
    "growth:apply": "node scripts/growth-tool.js apply --write",
    "growth:verify": "node scripts/growth-tool.js verify",
    "live:postpush:check": "bash scripts/live-postpush-check.sh https://fitpo50.pl",
    "live:latest:check": "node scripts/live-latest-article-check.js --base-url https://fitpo50.pl",
    "article:pdf:sync": "python3 scripts/sync_article_pdfs_and_buttons.py",
    "article:pdf:builder": "python3 scripts/article-pdf-builder.py",
    "predeploy:check": "node scripts/predeploy-gate.js",
    "test:publishing-engine": "node --test tests/publishing-engine.test.js",
    "test:importer-faq-research": "node --test tests/import-article-faq-research.test.js",
    "seo:aeo:guard": "node scripts/seo-aeo-guard.js",
    "quick-answer:backlog": "node scripts/audit-quick-answer-backlog.js",
    "news:integrity": "node scripts/news-integrity-check.js",
    "assets:mirror:sync": "node scripts/sync-site-assets-mirror.js",
    "assets:mirror:check": "node scripts/sync-site-assets-mirror.js --check",
    "sitemap:lastmod:sync": "node scripts/sync-sitemap-lastmod.js",
    "sitemap:lastmod:check": "node scripts/sync-sitemap-lastmod.js --check",
    "assets:audit": "node scripts/assets-audit.js --report data/reports/assets-audit.json",
    "assets:audit:apply": "node scripts/assets-audit.js --apply --report data/reports/assets-audit.json",
    "search:index": "node scripts/generate-search-index.js",
    "llms:full": "node scripts/generate-llms-full.js",
    "assets:trash:prune": "node scripts/assets-trash-retention.js --days 14",
    "assets:trash:prune:dry": "node scripts/assets-trash-retention.js --days 14 --dry-run",
    "json:gate:diff": "node scripts/json-fitpo50-gate-diff.js",
    "json:gate:file": "node scripts/json-fitpo50-gate-diff.js --file \"$npm_config_file\"",
    "json:fix": "node scripts/fix-fitpo50-json.js",
    "json:autofix:strict": "node scripts/json-autofix-strict.js",
    "eeat:citation:enhance": "node scripts/eeat-citation-enhancer.js",
    "interlinking:optimize": "node scripts/global-link-topology-optimizer.js",
    "visual:regression:gate": "node scripts/visual-regression-gate.js",
    "visual:regression:update-baseline": "node scripts/visual-regression-gate.js --update-baseline true",
    "article:fast-gate": "node scripts/article-fast-gate.js",
    "article:paste": "node scripts/article-paste.js",
    "article:preflight": "node scripts/article-preflight.js",
    "article:ready-check": "node scripts/article-ready-check.js",
    "article:final-check": "node scripts/article-final-check.js",
    "article:assets:prepare": "node scripts/prepare-article-assets.js",
    "article:lint:placeholders": "node scripts/lint-editorial-placeholders.js",
    "article:pipeline": "node scripts/article-pipeline.js",
    "article:publish": "node scripts/article-pipeline.js --file \"$npm_config_file\"",
    "dev:article": "node scripts/dev-article-watch.js",
    "article:import:safe": "node -e \"console.error('[DEPRECATED] Użyj article:publish/article:pipeline; ten alias uruchamia teraz pełny pipeline.')\" && node scripts/article-pipeline.js --file \"$npm_config_file\"",
    "prepush:diff-guard": "node scripts/prepush-diff-guard.js",
    "smoke:static": "node scripts/static-smoke-check.js _site",
    "broken-links:crawl": "node scripts/broken-links-crawler.js _site",
    "seo:crawl": "node scripts/broken-links-crawler.js _site",
    "cwv:budget": "node scripts/cwv-performance-budget.js",
    "hostinger:clean-repo": "bash scripts/hostinger-clean-repo.sh",
    "workflow:maintenance": "node scripts/workflow-maintenance-check.js",
    "check:build-export": "node scripts/check-build-export.js",
    "check:build-export:fast": "node scripts/check-build-export.js --skip-broken-links",
    "check:site:fast": "npm run build && node scripts/static-smoke-check.js _site",
    "prepush:parallel:checks": "node scripts/prepush-parallel-checks.js",
    "prepush:worktree": "node scripts/prepush-parallel-checks.js --worktree",
    "site:full-audit": "npm run check:build-export && npm run broken-links:crawl && npm run workflow:maintenance && npm run aio:full-audit",
    "tmp:cleanup": "node scripts/tmp-cleanup.js",
    "tmp:cleanup:dry": "node scripts/tmp-cleanup.js --dry-run",
    "prepush:strict": "npm run prepush:diff-guard && npm run prepush:parallel:checks && npm run check:build-export && npm run tmp:cleanup",
    "prepush:local": "node scripts/run-all-prepush.js",
    "prepush:checks": "node scripts/prepush-checks.js",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "sync:local:safe": "bash scripts/local-sync-safe.sh",
    "topic-centers:sync": "node scripts/sync-topic-centers.js"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "esbuild": "^0.25.5",
    "playwright": "^1.60.0",
    "terser": "^5.46.1",
    "typescript": "^5.5.0",
    "undici-types": "^8.1.0"
  }
}
